# Copy this to .env and fill in secrets — NEVER commit real credentials to git.
# For production deployments use stack-specific .env.production files (see docs/PRODUCTION_RUNBOOK.md).

APP_ENV=development
GITHUB_TOKEN=ghp_your-personal-access-token
LLM_API_KEY=sk-your-llm-api-key-here
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
SESSION_SECRET_KEY=change-me-to-32-plus-random-bytes
GITHUB_WEBHOOK_SECRET=your-webhook-secret
DATABASE_URL=sqlite:///./devops_platform.db
QUEUE_BACKEND=memory
QA_MODE=simulated
NGINX_MODE=development
FLOWER_BASIC_AUTH_USER=admin
FLOWER_BASIC_AUTH_PASSWORD=change-me
