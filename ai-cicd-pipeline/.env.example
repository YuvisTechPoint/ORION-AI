# ---- Core -----------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8001
STACK_HOST=127.0.0.1
SECRET_KEY=orion-secret-key-min-32-chars-here
# SQLite needs no server; docker-compose overrides these with its Postgres service.
DATABASE_URL=sqlite+aiosqlite:///./orion.db
SYNC_DATABASE_URL=sqlite:///./orion.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aicicd
# SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicicd
# Optional: only used when PIPELINE_EXECUTOR resolves to celery.
REDIS_URL=redis://localhost:6379/0
# auto = Celery when Redis answers, otherwise run pipelines inside the API process | celery | inline
PIPELINE_EXECUTOR=auto
PIPELINE_INLINE_CONCURRENCY=2
SQL_ECHO=false
CORS_ORIGINS=http://127.0.0.1:8001,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:5180
HUB_URL=http://127.0.0.1:5180
CANONICAL_API_URL=http://127.0.0.1:8000
CANONICAL_UI_URL=http://127.0.0.1:5173
DEVOPS_API_URL=http://127.0.0.1:8002
DEVOPS_UI_URL=http://127.0.0.1:3000
# Require GitHub OAuth login for retry/multimodal endpoints (CLI + tests work without it)
API_REQUIRE_AUTH=false

# ---- Anthropic (placeholder key => agents run in heuristic mode) ----------------------
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Optional per-agent model overrides (default to ANTHROPIC_MODEL's value)
ORCHESTRATOR_MODEL=claude-sonnet-4-20250514
CODE_ANALYSIS_MODEL=claude-sonnet-4-20250514
SECURITY_MODEL=claude-sonnet-4-20250514
QA_MODEL=claude-sonnet-4-20250514
STRESS_MODEL=claude-sonnet-4-20250514
APPROVAL_MODEL=claude-sonnet-4-20250514
DEPLOYMENT_MODEL=claude-sonnet-4-20250514
MONITORING_MODEL=claude-sonnet-4-20250514
MULTIMODAL_PAYMENT_MODEL=claude-sonnet-4-20250514
MULTIMODAL_GIT_MODEL=claude-sonnet-4-20250514
MODEL_DEVICE_MODE=cpu

# ---- GitHub -----------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_TOKEN=ghp_your-personal-access-token
GITHUB_OWNER=your-github-username
GITHUB_CLIENT_ID=your-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-oauth-app-client-secret
GITHUB_REDIRECT_URI=http://localhost:8001/api/v1/auth/github/callback
SESSION_SECRET_KEY=orion-super-secret-session-key-abc123
FRONTEND_URL=http://localhost:8001/ui/
OAUTH_TOKEN_EXPIRY_HOURS=24

# ---- Notifications ----------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ---- Deployment / staging ---------------------------------------------------------------
STAGING_URL=http://localhost:8080
STAGING_HOST_PORT=8080
STAGING_CONTAINER_PORT=8000
CONTAINER_REGISTRY=your-registry.io
APP_NAME=orion-app
DEPLOY_ENVIRONMENT=staging
# auto = Docker when a daemon is reachable, otherwise simulate deploy + monitoring | docker | simulate | skip
DEPLOY_MODE=auto

# ---- API hardening -----------------------------------------------------------------------
# Require GitHub session or X-ORION-API-Key for pipeline/multimodal APIs (auto-enabled in production)
API_REQUIRE_AUTH=false
# ORION_API_KEY=your-long-random-automation-key

# ---- Quality gates ----------------------------------------------------------------------
MAX_SECURITY_SEVERITY=medium
# External scanners (heuristic fallback when tool not on PATH)
SECURITY_GITLEAKS_ENABLED=true
SECURITY_TRIVY_ENABLED=true
SECURITY_CHECKOV_ENABLED=true
SECURITY_SEMGREP_ENABLED=true
SBOM_SYFT_ENABLED=true
SECURITY_ZAP_ENABLED=true
EPSS_ENABLED=true
DAST_GATE_ENABLED=false
ZAP_TIMEOUT_SECONDS=300
# Optional explicit binary paths: GITLEAKS_PATH, TRIVY_PATH, CHECKOV_PATH, SEMGREP_PATH, SYFT_PATH, ZAP_PATH
STRESS_TEST_USERS=1000
STRESS_TEST_DURATION=60
STRESS_TEST_SPAWN_RATE=50

# ---- Phase 2 progressive delivery -------------------------------------------------------
PROGRESSIVE_DELIVERY_ENABLED=true
CANARY_STAGES=5,25,50,100
CANARY_MAX_P95_MS=2000
PREVIEW_BASE_URL=http://{pr}.preview.orion.internal
PATCH_AUTO_PR_ENFORCEMENT=true

# ---- Phase 3 SRE intelligence -----------------------------------------------------------
SLO_TARGET_AVAILABILITY=0.999
SYNTHETIC_MONITORING_LIVE=false
SLO_ALERT_SLACK_ENABLED=true
SLO_ALERT_COOLDOWN_SECONDS=3600

# ---- Phase 4 enterprise -----------------------------------------------------------------
POLICY_ENFORCEMENT_ENABLED=true
POLICY_STRICT_REQUIREMENTS=false
APPROVAL_REQUIRED_COUNT=1
APPROVAL_FOUR_EYES_ENABLED=false
APPROVAL_SIGNED_REQUIRED=false
APPROVAL_ORG_WORKFLOW_JSON={}
APPROVAL_REPO_WORKFLOW_JSON={}
APPROVAL_ENV_WORKFLOW_JSON={}
APPROVAL_HIGH_RISK_THRESHOLD=70
APPROVAL_HIGH_RISK_REQUIRED_COUNT=2
ENTERPRISE_APPROVAL_ENFORCEMENT_ENABLED=false
ENTERPRISE_APPROVAL_SIMULATED=true
APPROVAL_SIGNATURE_SECRET=
KUBERNETES_MANIFEST_SCAN_ENABLED=true
CLOUD_DEPLOY_TARGET=
CLOUD_TARGET_JSON={}
CLOUD_INTELLIGENCE_GATE_ENABLED=false
SERVICE_CATALOG_SCAN_ENABLED=true
SERVICE_CATALOG_JSON={}
IDP_GOLDEN_PATHS_JSON={}
SERVICE_CATALOG_GATE_ENABLED=false
SERVICE_CATALOG_MIN_COMPLETENESS_PERCENT=60
REQUIRE_SIGNED_BUILDS=false
TENANT_ISOLATION_MODE=org
COMPLIANCE_PACKS=soc2,iso27001,owasp,cis
FINOPS_LLM_COST_PER_1K_TOKENS=0.003
FINOPS_COMPUTE_COST_PER_MINUTE=0.008
FINOPS_BUDGET_USD_PER_RUN=5.0
FINOPS_BUDGET_USD_MONTHLY=500.0
FINOPS_BUDGET_JSON={}
FINOPS_GATE_ENABLED=false
RELEASE_MAX_RISK_SCORE=60
RELEASE_PREDICTION_BLOCK_THRESHOLD=70
RELEASE_REQUIRE_PASSPORT_PASS=true
RELEASE_POLICY_JSON={}
RELEASE_INTELLIGENCE_GATE_ENABLED=false

# ---- Developer UX (Phase 22) --------------------------------------------------------------
GITHUB_APP_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_NAME=ORION DevOps
GITHUB_APP_DESCRIPTION=AI-native CI/CD pipeline, PR intelligence, and release gates.
GITHUB_APP_INSTALLATION_MODE=repository
GITHUB_APP_CONFIG_JSON={}
SSO_SAML_ENTITY_ID=
SSO_SAML_METADATA_URL=
SSO_OIDC_ISSUER=
SSO_OIDC_CLIENT_ID=
IAM_POLICY_JSON={}
IAM_GATE_ENABLED=false
IAM_MFA_REQUIRED=false
IAM_MIN_READINESS_SCORE=70
IAM_REQUIRE_SSO_IN_PRODUCTION=false
CHAOS_POLICY_JSON={}
CHAOS_SIMULATED_DEFAULT=true
CHAOS_LIVE_ENABLED=false
RELIABILITY_GATE_ENABLED=false
RELIABILITY_MIN_RESILIENCE_SCORE=70
RELIABILITY_REQUIRE_SYNTHETIC_PASS=false
DR_POLICY_JSON={}
DR_BACKUP_DIR=
DR_GATE_ENABLED=false
DR_RTO_TARGET_HOURS=4
DR_RPO_TARGET_HOURS=24
DR_MAX_BACKUP_AGE_HOURS=24
DR_BACKUP_RETENTION_COUNT=7
DR_RESTORE_DRILL_SIMULATED=true
KNOWLEDGE_GRAPH_POLICY_JSON={}
KNOWLEDGE_GRAPH_GATE_ENABLED=false
KNOWLEDGE_GRAPH_MIN_NODES=5
KNOWLEDGE_GRAPH_MIN_COVERAGE_PERCENT=40
KNOWLEDGE_GRAPH_REQUIRE_SERVICE_GRAPH=false
KNOWLEDGE_GRAPH_REQUIRE_REPOSITORY_INTEL=false
AUTOPILOT_ENABLED=true
AUTOPILOT_SIMULATE_ONLY=true
AUTOPILOT_GATE_ENABLED=false
AUTOPILOT_POLICY_JSON={}
AUTOPILOT_MAX_AUTONOMY_LEVEL=L4
AUTOPILOT_AUTO_PR_ALLOWED=true
AUTOPILOT_RETRY_ALLOWED=false
AUTOPILOT_DEPLOY_ALLOWED=true
AUTOPILOT_REQUIRE_APPROVAL_ABOVE_RISK=60
UNIFIED_RISK_ENABLED=true
UNIFIED_RISK_GATE_ENABLED=false
UNIFIED_RISK_MAX_SCORE=60
UNIFIED_RISK_BLOCK_ON_HIGH=false
UNIFIED_RISK_REQUIRE_GATE_FUSION_PASS=true
UNIFIED_RISK_POLICY_JSON={}

# ---- Phase 5 AI platform ----------------------------------------------------------------
PROMPT_INJECTION_GATE_ENABLED=true
MODEL_ROUTER_ENABLED=true
AGENT_EVAL_MIN_SCORE=0.6
AGENT_EVAL_GATE_ENABLED=false
DEVOPS_RAG_MAX_CHUNKS=8
AGENT_MEMORY_ENABLED=true
AGENT_MEMORY_SQLITE_PATH=
AGENT_MEMORY_CONTEXT_LIMIT=3
AGENT_MEMORY_MAX_ENTRIES_PER_SCOPE=20
RETRIEVER_BACKEND=hybrid
RETRIEVER_CHUNK_SIZE=800
RAG_INDEX_ENABLED=true
RAG_INDEX_MAX_FILES=120
RAG_INDEX_MAX_FILE_BYTES=80000
AGENT_MESH_GATE_ENABLED=false
AGENT_MESH_MIN_COVERAGE_PERCENT=40
AGENT_MESH_OVERRIDES_JSON={}
AI_GOVERNANCE_GATE_ENABLED=false
AI_GOVERNANCE_MIN_CONFIDENCE=0.70
AI_GOVERNANCE_ESCALATION_THRESHOLD=0.70
AI_GOVERNANCE_MIN_SCORE=0.55
AI_GOVERNANCE_POLICY_JSON={}
SMALL_MODEL_SLUG=claude-haiku-3-20250325

# ---- Monitoring -------------------------------------------------------------------------
MONITORING_POLL_INTERVAL_SECONDS=30
MONITORING_WINDOW_MINUTES=5
HEALTH_CHECK_TIMEOUT_SECONDS=180
JOURNALD_ENABLED=true

# ---- Nginx / Flower ---------------------------------------------------------------------
NGINX_MODE=development
# orion_dev.conf (HTTP :80) or orion.conf (HTTPS :443); used by docker compose
NGINX_SITE_CONF=orion_dev.conf
FLOWER_BASIC_AUTH_USER=admin
FLOWER_BASIC_AUTH_PASSWORD=orion_admin
