# ORION production template — copy to .env.production and replace ALL placeholders.
# Run: ..\.venv\Scripts\python ..\scripts\production_preflight.py before deploy.

APP_ENV=production
APP_PORT=8001
STACK_HOST=0.0.0.0

# Cryptography & sessions (rotate on compromise)
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX
SESSION_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX

# PostgreSQL + Redis (see docker-compose.prod.yml)
DATABASE_URL=postgresql+asyncpg://orion:REPLACE_DB_PASSWORD@127.0.0.1:5432/orion
SYNC_DATABASE_URL=postgresql://orion:REPLACE_DB_PASSWORD@127.0.0.1:5432/orion
REDIS_URL=redis://127.0.0.1:6379/0
PIPELINE_EXECUTOR=celery

# Auth — required in production (auto-enabled)
API_REQUIRE_AUTH=true
AUTH_API_KEYS_JSON={"REPLACE_KEY_ID":{"user_id":"ops","roles":["admin","operator","approver"]}}

# GitHub
GITHUB_WEBHOOK_SECRET=REPLACE_DEDICATED_WEBHOOK_SECRET
GITHUB_TOKEN=ghp_REPLACE_WITH_SCOPED_TOKEN
GITHUB_CLIENT_ID=REPLACE_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_OAUTH_CLIENT_SECRET
GITHUB_REDIRECT_URI=https://orion.example.com/api/v1/auth/github/callback

# LLM (heuristic fallback if omitted)
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/REPLACE/REPLACE
SLO_ALERT_SLACK_ENABLED=true

# Deployment
DEPLOY_MODE=auto
STAGING_URL=https://staging.example.com
CONTAINER_REGISTRY=registry.example.com/orion
CORS_ORIGINS=https://orion.example.com,https://hub.example.com

# Security gates (recommended production defaults)
PROMPT_INJECTION_GATE_ENABLED=true
POLICY_ENFORCEMENT_ENABLED=true
POLICY_STRICT_REQUIREMENTS=true
UNIFIED_RISK_GATE_ENABLED=true
UNIFIED_RISK_ENABLED=true
AUTOPILOT_SIMULATE_ONLY=true
PROGRESSIVE_DELIVERY_ENABLED=true
DAST_GATE_ENABLED=false
SECURITY_ZAP_ENABLED=true
EPSS_ENABLED=true
REQUIRE_SIGNED_BUILDS=false

# Rate limiting
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
