[Unit]
Description=ORION API
After=network.target postgresql.service redis.service

[Service]
Type=exec
User=orion
WorkingDirectory=/opt/orion
EnvironmentFile=/etc/orion/orion.env
ExecStart=/opt/orion/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8001 --workers 4
Restart=on-failure
RestartSec=10s
StandardOutput=journal
SyslogIdentifier=orion-api
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
