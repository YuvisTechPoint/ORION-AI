[Unit]
Description=ORION Host Monitor
After=network.target

[Service]
Type=exec
User=orion
WorkingDirectory=/opt/orion
EnvironmentFile=/etc/orion/orion.env
ExecStart=/opt/orion/venv/bin/python -m app.daemon.monitor_daemon
Restart=always
RestartSec=5s
StandardOutput=journal
SyslogIdentifier=orion-monitor
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
