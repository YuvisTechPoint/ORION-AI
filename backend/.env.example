# Local defaults — copy to .env and adjust as needed.

APP_ENV=dev
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# SQLite for local dev; use postgres URL inside docker-compose only.
DATABASE_URL=sqlite:///./devops_platform.db
QUEUE_BACKEND=memory
QA_MODE=simulated
LLM_MODE=auto

# Optional live providers (heuristic fallback used when unset or failing in auto mode)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

SESSION_SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32
AUTH_ENABLED=false
API_REQUIRE_AUTH=false
PIPELINE_EXECUTOR=inline
SLACK_WEBHOOK_URL=
SECURITY_SCANNERS_ENABLED=true
RATE_LIMIT_BACKEND=auto
