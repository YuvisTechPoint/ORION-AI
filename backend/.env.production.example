# Canonical stack production template — copy to .env.production

APP_ENV=production
SESSION_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX
GITHUB_WEBHOOK_SECRET=REPLACE_DEDICATED_WEBHOOK_SECRET
GITHUB_TOKEN=ghp_REPLACE_WITH_SCOPED_TOKEN
GITHUB_CLIENT_ID=REPLACE_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_OAUTH_CLIENT_SECRET
GITHUB_REDIRECT_URI=https://canonical.example.com/api/v1/auth/github/callback

DATABASE_URL=postgresql://orion:REPLACE_DB_PASSWORD@127.0.0.1:5432/canonical
SYNC_DATABASE_URL=postgresql://orion:REPLACE_DB_PASSWORD@127.0.0.1:5432/canonical
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_BACKEND=redis
PIPELINE_EXECUTOR=celery

AUTH_ENABLED=true
API_REQUIRE_AUTH=true
AUTH_API_KEYS_JSON={"REPLACE_KEY_ID":{"user_id":"ops","roles":["admin","operator"]}}

ANTHROPIC_API_KEY=sk-ant-api03-REPLACE
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/REPLACE/REPLACE
QA_MODE=real
LLM_MODE=auto
SECURITY_SCANNERS_ENABLED=true
RATE_LIMIT_BACKEND=auto
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
