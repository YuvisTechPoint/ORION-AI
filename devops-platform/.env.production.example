# DevOps platform production template — copy to .env.production

APP_ENV=production
API_REQUIRE_AUTH=true
ORION_API_KEY=REPLACE_ORION_AUTOMATION_KEY
DEPLOYMENT_API_KEY=REPLACE_DEPLOY_APPROVER_KEY
GITHUB_WEBHOOK_SECRET=REPLACE_DEDICATED_WEBHOOK_SECRET
GITHUB_TOKEN=ghp_REPLACE_WITH_SCOPED_TOKEN

DATABASE_URL=postgresql+asyncpg://orion:REPLACE_DB_PASSWORD@127.0.0.1:5432/devops
SYNC_DATABASE_URL=postgresql://orion:REPLACE_DB_PASSWORD@127.0.0.1:5432/devops
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
PIPELINE_EXECUTOR=celery

ORION_API_URL=http://127.0.0.1:8001
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/REPLACE/REPLACE
DEPLOY_MODE=auto
RATE_LIMIT_BACKEND=auto
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_SCANNERS_ENABLED=true
