[Unit]
Description=ORION AI Pipeline API Server
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=exec
User=orion
Group=orion
WorkingDirectory=/opt/orion
EnvironmentFile=/etc/orion/orion.env
ExecStart=/opt/orion/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000 --workers 4 --log-level info
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orion-api
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
